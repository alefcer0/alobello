# Meta / Facebook
META_VERIFY_TOKEN=your_meta_verify_token_here
META_APP_SECRET=your_meta_app_secret_here
META_PAGE_ACCESS_TOKEN=your_meta_page_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=nopal_leads
DATABASE_URL=postgresql://postgres:postgres@db:5432/nopal_leads

# Session lifecycle
SESSION_IDLE_TIMEOUT_MINUTES=10
SESSION_MAX_DURATION_MINUTES=30

# Burst message aggregation
MESSAGE_BURST_INACTIVITY_SECONDS=1.5
MESSAGE_BURST_MAX_WAIT_SECONDS=4.0
MESSAGE_BURST_MAX_MESSAGES=5

# Human handoff
HANDOFF_IDLE_TIMEOUT_MINUTES=30
BOT_OUTBOUND_EVENT_TTL_SECONDS=180

# Conversation behavior
MAX_CLARIFICATION_ATTEMPTS=3
MAX_TOPIC_CHANGES=2

# Auth / JWT
JWT_SECRET_KEY=change_this_to_a_long_random_secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480
SUPERUSER_USERNAME=admin
SUPERUSER_PASSWORD=change_this_superuser_password
